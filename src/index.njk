---
layout: base.njk
title: "Richmond Petersburg Christadelphians - A Community of Faith"
description: "Welcome to the Richmond Petersburg Christadelphian Ecclesia. Join us as we study the Bible and follow the teachings of Jesus Christ."
---
{% from "macros/service-icons.njk" import serviceIcon %}

<section class="hero">
    <div class="hero__inner">
        <div class="hero__header">
            <h1 class="hero__title corinthia-bold">Welcome</h1>
            <p class="hero__subtitle">A community dedicated to understanding and living the Bible's teachings</p>
        </div>
        <div class="hero__footer">
            <div class="hero__schedule">
                <h2 class="hero__schedule-heading">Schedule</h2>
                <div class="hero__schedule-list" role="list">
                    {% for row in schedule.heroSchedule %}
                    <div class="hero__schedule-item" role="listitem">
                        <span class="hero__schedule-label">{{ row.label }}</span>
                        <span class="hero__schedule-time">{{ row.time }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
            <a href="/visit" class="hero__btn hero__btn--primary">Plan Your Visit</a>
        </div>
    </div>
    <div class="hero__scroll">
        <span>Scroll to explore</span>
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
    </div>
</section>

<section class="welcome">
    <div class="welcome__container">
        <div class="welcome__content">
            <h2 class="welcome__heading">Who We Are</h2>
            <p class="welcome__text">
                The Christadelphians are a worldwide community of Bible students who believe in One God, the Father, and His son Jesus Christ. We strive to follow the example of the early Christian community as described in the New Testament.
                Christadelphian is a biblical Greek word simply meaning "Brethren in Christ". Christadelphians teach and endeavor to live the gospel or good news that Jesus Christ taught and lived when he walked the earth almost 2000 years ago. By using the Bible as the authority, Christadelphians profess a faith the Apostle Paul termed "The Hope of Israel".
            </p>
            <p class="welcome__text">
                We are a small group of Bible believers which meet twice weekly for our services in Richmond Petersburg. Feel free to come and visit us during one of our classes. Christadelphians put an emphasis on reasoning from the Bible and a faith based on proven facts.
            </p>
            <a href="/about" class="welcome__link">Learn More About Us →</a>
        </div>
        <div class="welcome__image">
            <img src="https://images.unsplash.com/photo-1604882737206-8a000c03d8fe?q=80&w=774&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="A group of Christadelphians reading the bible together." />
        </div>
    </div>
</section>

<section class="service-times">
    <div class="service-times__container">
        <h2 class="service-times__heading">You Are Invited to Our Upcoming Services</h2>
        <p class="service-times__subheading">Come join us to gather around God's word! A warm welcome awaits you!</p>

        <div class="service-times__grid">
            {% for svc in schedule.homepageServices %}
            <div class="service-card">
                <div class="service-card__icon">
                    {{ serviceIcon(svc.icon) }}
                </div>
                <h3 class="service-card__title">{{ svc.title }}</h3>
                <p class="service-card__time">{{ svc.timeLine }}</p>
                <p class="service-card__description">{{ svc.description }}</p>
            </div>
            {% endfor %}
        </div>

        <div class="service-times__cta">
            <a href="/visit" class="service-times__btn">Plan Your Visit</a>
        </div>
    </div>
</section>

<section class="beliefs">
    <div class="beliefs__container">
        <div class="beliefs__intro">
            <h2 class="beliefs__heading">What We Believe</h2>
            <p class="beliefs__subheading">Our faith is built on the Bible alone</p>
        </div>

        <div class="beliefs__grid">
            <div class="belief-card">
                <div class="belief-card__number">01</div>
                <h3 class="belief-card__title">One God</h3>
                <p class="belief-card__text">
                    We believe in one God, the Father, creator of heaven and earth, as revealed in Scripture.
                </p>
            </div>

            <div class="belief-card">
                <div class="belief-card__number">02</div>
                <h3 class="belief-card__title">Jesus Christ</h3>
                <p class="belief-card__text">
                    We believe Jesus is the Son of God, our Savior who died for our sins and was raised to life.
                </p>
            </div>

            <div class="belief-card">
                <div class="belief-card__number">03</div>
                <h3 class="belief-card__title">The Bible</h3>
                <p class="belief-card__text">
                    We believe the Bible is God's inspired word, our sole authority for faith and practice.
                </p>
            </div>

            <div class="belief-card">
                <div class="belief-card__number">04</div>
                <h3 class="belief-card__title">Kingdom of God</h3>
                <p class="belief-card__text">
                    We believe Jesus will return to establish God's Kingdom on earth, bringing peace and righteousness.
                </p>
            </div>
</div>

        <div class="beliefs__cta">
            <a href="/about" class="beliefs__link">Explore Our Beliefs in Detail →</a>
        </div>
    </div>
</section>

<section class="faq">
    <div class="faq__container">
        <div class="faq__content">
            <h2 class="faq__heading">Common Questions</h2>
            
            <div class="faq__list">
                <details class="faq__item" open>
                    <summary class="faq__question">
                        Can everyone attend?
                        <svg class="faq__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </summary>
                    <div class="faq__answer">
                        <p>Yes. We have classes for children and adults, so there is something for individuals of all ages.</p>
                    </div>
                </details>

                <details class="faq__item">
                    <summary class="faq__question">
                        Will I feel comfortable attending alone?
                        <svg class="faq__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </summary>
                    <div class="faq__answer">
                        <p>Absolutely! We have many members who first visited alone. Our community is welcoming and friendly, and we make it a priority to help newcomers feel at home. If you have any questions, please feel free to contact us, and we'll be happy to offer you a guide to make you feel welcome.</p>
                    </div>
                </details>

                <details class="faq__item">
                    <summary class="faq__question">
                        Will I have to participate?
                        <svg class="faq__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </summary>
                    <div class="faq__answer">
                        <p>Not at all. Visitors are welcome to simply observe and learn. There's no pressure to participate in any way you're not comfortable with. You can sit back, listen, and take everything in at your own pace.</p>
                    </div>
                </details>

                <details class="faq__item">
                    <summary class="faq__question">
                        What are your services like?
                        <svg class="faq__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </summary>
                    <div class="faq__answer">
                        <p>Our services are simple and focused on Scripture. Sunday morning includes hymns, prayers, Bible readings, and the breaking of bread (for our baptized members) in remembrance of Jesus Christ. Wednesday evenings are interactive Bible studies where we explore God's word together in presented classes by a variety of speakers, offering time for discussion and sharing of ideas.</p>
                    </div>
                </details>

                <details class="faq__item">
                    <summary class="faq__question">
                        What should I wear?
                        <svg class="faq__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </summary>
                    <div class="faq__answer">
                        <p>Come as you are! Our members dress formally to Sunday School and Memorial Service, but are welcome to wear casual attire to Wednesday Evening Bible Class.</p>
                    </div>
                </details>
            </div>

            <a href="/contact" class="faq__link">Ask Us a Question</a>
        </div>
        
        <div class="faq__image">
            <img src="https://plus.unsplash.com/premium_photo-1715588659678-81acb0fb63cd?q=80&w=1742&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Welcoming church member" />
        </div>
    </div>
</section>

<section class="videos-section">
    <div class="videos-section__container">
        <h2 class="videos-section__heading">Videos</h2>
        <p class="videos-section__intro">
            Watch recent teachings and updates from our community.
        </p>

        {% if videos.recent | length %}
        <div class="video-carousel">
            <div class="video-carousel__track">
                {% for video in videos.recent %}
                {% include "video-card.njk" %}
                {% endfor %}
            </div>
        </div>

        <div class="videos-section__cta">
            <a href="/videos/" class="btn btn-outline">View All Videos</a>
        </div>
        {% else %}
        <p class="videos-section__empty">No videos yet. Check back soon.</p>
        {% endif %}
    </div>
</section>

<section class="connect">
    <div class="connect__container">
        <div class="connect__content">
            <h2 class="connect__heading">Get Connected</h2>
            <p class="connect__text">
                We'd love to hear from you! Whether you're interested in learning more about our beliefs, planning a visit, or have questions about faith, we're here to help.
            </p>
            <div class="connect__actions">
                <a href="/contact" class="connect__btn connect__btn--primary">Contact Us</a>
                <a target="_blank" rel="noopener noreferrer" href="https://www.bibleunlocked.com/live" class="connect__btn connect__btn--outline">Join a Study Group</a>
            </div>
        </div>
        <div class="connect__info">
            <div class="connect__info-item">
                <svg class="connect__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                </svg>
                <div>
                    <h3 class="connect__info-title">Location</h3>
                    <p class="connect__info-text">8716 W Broad St, Richmond, VA 23294</p>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="flyer-modal" class="flyer-modal" hidden>
    <div class="flyer-modal__backdrop" data-flyer-close tabindex="-1" aria-hidden="true"></div>
    <div
        class="flyer-modal__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="flyer-modal-title"
    >
        <button type="button" class="flyer-modal__close" data-flyer-close aria-label="Close announcement">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                <path d="M18 6L6 18M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>
        <div class="flyer-modal__body">
            <div class="flyer-modal__image-wrap">
                <img src="/assets/flyer.png" alt="" width="1066" height="1374" class="flyer-modal__image" />
            </div>
            <div class="flyer-modal__text">
                <p class="flyer-modal__eyebrow">You're invited to our</p>
                <h2 class="flyer-modal__headline" id="flyer-modal-title">Bible study series</h2>
                <p class="flyer-modal__when">Wednesdays at 7:30 PM</p>
                <p class="flyer-modal__address">8716 W Broad St, Richmond, VA 23294</p>
                <ul class="flyer-modal__sessions" aria-label="Upcoming sessions">
                    <li class="flyer-modal__session">
                        <span class="flyer-modal__session-date">March 18th</span>
                        <span class="flyer-modal__session-title">“The Power and Purpose of the Holy Spirit Gifts”</span>
                    </li>
                    <li class="flyer-modal__session">
                        <span class="flyer-modal__session-date">April 8th</span>
                        <span class="flyer-modal__session-title">“Revealing the Hope of the Bible”</span>
                    </li>
                    <li class="flyer-modal__session">
                        <span class="flyer-modal__session-date">May 6th</span>
                        <span class="flyer-modal__session-title">“The Nature of Man — Death vs. Immortality”</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var STORAGE_KEY = 'toc_flyer_modal_date';

    // First local calendar day the flyer modal no longer runs (still shown on prior days).
    // For a future campaign: set a new end date and update the modal markup above.
    var FLYER_MODAL_CAMPAIGN_END = new Date(2026, 4, 7);

    function isFlyerCampaignActive() {
        var now = new Date();
        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        return today < FLYER_MODAL_CAMPAIGN_END;
    }

    function todayKey() {
        var d = new Date();
        return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    var modal = document.getElementById('flyer-modal');
    if (!modal) return;

    if (!isFlyerCampaignActive()) return;

    var prevOverflow = '';

    function shouldShow() {
        try {
            return localStorage.getItem(STORAGE_KEY) !== todayKey();
        } catch (e) {
            return true;
        }
    }

    function rememberDismissed() {
        try {
            localStorage.setItem(STORAGE_KEY, todayKey());
        } catch (e) { /* ignore */ }
    }

    function openModal() {
        modal.removeAttribute('hidden');
        prevOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        var closeBtn = modal.querySelector('.flyer-modal__close');
        if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
        modal.setAttribute('hidden', '');
        document.body.style.overflow = prevOverflow;
        rememberDismissed();
    }

    if (!shouldShow()) return;

    openModal();

    modal.addEventListener('click', function (e) {
        if (e.target.closest('[data-flyer-close]')) closeModal();
    });

    document.addEventListener('keydown', function onKey(e) {
        if (e.key === 'Escape' && !modal.hasAttribute('hidden')) {
            closeModal();
        }
    });
})();
</script>
