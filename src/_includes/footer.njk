<footer class="site-footer">
    <div class="footer__container">
        <div class="footer__main">
            <div class="footer__section footer__section--about">
                <h3 class="footer__heading">Richmond Petersburg Christadelphians</h3>
                <p class="footer__text">A community dedicated to following the teachings of Jesus Christ and the Bible.</p>
            </div>

            <div class="footer__section footer__section--links">
                <h3 class="footer__heading">Quick Links</h3>
                <ul class="footer__links">
                    <li><a href="/about" class="footer__link">About Us</a></li>
                    <li><a href="/blog/" class="footer__link">Articles</a></li>
                    <li><a href="/visit" class="footer__link">Visit Us</a></li>
                    <li><a href="/contact" class="footer__link">Contact Us</a></li>
                    <li><a rel="noopener noreferrer" href="https://www.bibleunlocked.com/" class="footer__link">Bible Unlocked</a></li>
                </ul>
            </div>

            <div class="footer__section footer__section--service">
                <h3 class="footer__heading">Service Times</h3>
                {% for row in schedule.footerServiceTimes %}
                <div class="footer__service-time">
                    <p class="footer__text"><strong>{{ row.title }}</strong></p>
                    <p class="footer__text">{{ row.time }}</p>
                </div>
                {% endfor %}
            </div>

            <div class="footer__section footer__section--contact">
                <h3 class="footer__heading">Visit Us</h3>
                <address class="footer__address">
                    8716 W Broad St<br>
                    Richmond, VA 23294
                </address>
            </div>
        </div>

        <div class="footer__bottom">
            <p class="footer__copyright">&copy; {{ page.date.getFullYear() if page.date else '2025' }} Richmond Petersburg Christadelphian Ecclesia. All rights reserved.</p>
            <div class="footer__legal">
                <a href="/accessibility" class="footer__legal-link">Accessibility Statement</a>
                <span class="footer__separator">|</span>
                <a href="/privacypolicy" class="footer__legal-link">Privacy Policy</a>
                <span class="footer__separator">|</span>
                <a href="/terms" class="footer__legal-link">Terms of Use</a>
            </div>
        </div>
    </div>
</footer> 