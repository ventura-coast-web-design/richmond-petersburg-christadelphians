<header class="site-header">
    <nav class="nav">
        <div class="nav__container">
            <a href="/" class="nav__logo">
                <img src="/assets/logo.png" alt="Richmond Petersburg Christadelphians" class="nav__logo-image">
            </a>
            
            <button class="nav__toggle" aria-label="Toggle navigation" aria-expanded="false">
                <span class="nav__toggle-line"></span>
                <span class="nav__toggle-line"></span>
                <span class="nav__toggle-line"></span>
            </button>

            <ul class="nav__menu">
                <li class="nav__item"><a href="/" class="nav__link">Home</a></li>
                <li class="nav__item"><a href="/about" class="nav__link">About</a></li>
                <li class="nav__item"><a href="/blog/" class="nav__link">Articles</a></li>
                {% if collections.upcomingEvents.length %}
                <li class="nav__item nav__item--dropdown" data-events-nav>
                    <a href="/events/" class="nav__link" aria-haspopup="true" aria-controls="nav-events-menu"{% if page.url == "/events/" %} aria-current="page"{% endif %}>Events<span class="nav__caret" aria-hidden="true"></span></a>
                    <ul class="nav__dropdown" id="nav-events-menu">
                        {% for event in collections.upcomingEvents %}
                        <li data-event-end="{{ event.data.eventLastDay }}">
                            <a href="{{ event.url }}" class="nav__sublink"{% if page.url == event.url %} aria-current="page"{% endif %}>
                                <span class="nav__sublink-title">{{ event.data.title }}</span>
                                <time class="nav__sublink-date" datetime="{{ event.date | htmlDate }}">{{ event.date | eventDate }}{% if event.data.endDate and (event.data.endDate | htmlDate) != (event.date | htmlDate) %} – {{ event.data.endDate | eventDate }}{% endif %}</time>
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </li>
                {% endif %}
                <li class="nav__item"><a href="/contact" class="nav__link">Contact</a></li>
                <li class="nav__item"><a href="/visit" class="nav__link nav__link--cta">Plan A Visit</a></li>
            </ul>
        </div>
    </nav>
</header>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const toggle = document.querySelector('.nav__toggle');
        const menu = document.querySelector('.nav__menu');
        const header = document.querySelector('.site-header');
        
        toggle.addEventListener('click', function() {
            const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', !isExpanded);
            toggle.classList.toggle('nav__toggle--active');
            menu.classList.toggle('nav__menu--active');
        });

        // Close menu when clicking outside
        document.addEventListener('click', function(event) {
            const isClickInside = header.contains(event.target);
            if (!isClickInside && menu.classList.contains('nav__menu--active')) {
                toggle.setAttribute('aria-expanded', 'false');
                toggle.classList.remove('nav__toggle--active');
                menu.classList.remove('nav__menu--active');
            }
        });

        const today = new Intl.DateTimeFormat("en-CA", {
            timeZone: "America/New_York",
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
        }).format(new Date());
        const eventsNav = document.querySelector("[data-events-nav]");
        if (eventsNav) {
            eventsNav.querySelectorAll("[data-event-end]").forEach(function (item) {
                if (item.getAttribute("data-event-end") < today) item.remove();
            });
            if (!eventsNav.querySelector("[data-event-end]")) eventsNav.remove();
        }

        // Handle scroll effect
        let lastScroll = 0;
        window.addEventListener('scroll', function() {
            const currentScroll = window.pageYOffset;
            if (currentScroll > 50) {
                header.classList.add('site-header--scrolled');
            } else {
                header.classList.remove('site-header--scrolled');
            }
            lastScroll = currentScroll;
        });
    });
</script> 